{
  "name": "stargazer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build:ssg",
    "build:ssg": "vite-ssg build",
    "build:spa": "npm run type-check && vite build",
    "format": "prettier --write --list-different src/ docs/ tests/",
    "import:artifacts": "tsx scripts/import-artifacts.ts",
    "import:charms": "tsx scripts/import-charms.ts",
    "import:phantimals": "tsx scripts/import-phantimals.ts",
    "import:seasonal": "npm run import:skills && npm run import:charms && npm run import:artifacts && npm run import:phantimals",
    "import:skills": "tsx scripts/import-skills.ts",
    "import:structure": "tsx scripts/import-structure.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prep": "npm run format && npm run type-check && npm run lint && npm run test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:it": "vitest run tests/integration",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.4",
    "html-to-image": "^1.11.13",
    "pinia": "^4.0.3",
    "vue": "^3.5.28",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-imagetools": "^12.0.0",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.5"
  }
}
